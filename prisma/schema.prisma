// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id              String          @id @unique
  username        String          @unique
  name            String
  email           String          @unique
  password        String
  cellphone       String
  created_at      Int
  updated_at      Int
  level           Int             @default(1)
  refresh_token   RefreshToken?

  @@map("users")
}

model RefreshToken {
  id              String          @id @unique
  experisIn       Int
  created_at      Int  
  user            User            @relation(fields: [userId], references: [id])
  userId          String          @unique

  @@map("refresh_token")
}